{
  "name": "pelitech-engineering-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PeliTech Engineering Atlas — an open-source engineering knowledge base on system design, architecture, backend engineering, databases, APIs and integrations.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run search:index",
    "dev": "next dev",
    "prebuild": "npm run search:index",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "search:index": "tsx scripts/build-search-index.ts",
    "validate": "tsx scripts/validate-content.ts",
    "check:pipeline": "tsx scripts/check-pipeline.ts",
    "new:article": "tsx scripts/new-article.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run validate && npm run check:pipeline"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "gray-matter": "4.0.3",
    "mermaid": "^11.17.2",
    "minisearch": "7.2.0",
    "next": "16.3.5",
    "next-mdx-remote": "6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.4.3",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "mdast-util-mdx-jsx": "^3.2.0",
    "prettier": "^3.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  }
}
